{
  "openapi": "3.0.3",
  "info": {
    "title": "SDC-SI Expense Management System",
    "description": "Role-based expense approval workflow backend. Supports Employee, Manager, and Finance roles with a strict status state machine, fraud detection engine, and monthly budget caps.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://sdc-si-backend-dev-challenge-2026.onrender.com/api",
      "description": "Production (Render)"
    },
    {
      "url": "http://localhost:5000/api",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["employee", "manager", "finance"] },
          "department_id": { "type": "integer", "nullable": true }
        }
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "category": { "type": "string", "enum": ["travel", "meals", "equipment", "software", "other"] },
          "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected"] },
          "author_id": { "type": "integer" },
          "department_id": { "type": "integer", "nullable": true },
          "receipt_url": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "rejection_reason": { "type": "string", "nullable": true },
          "submitted_at": { "type": "string", "format": "date-time", "nullable": true },
          "approved_at": { "type": "string", "format": "date-time", "nullable": true },
          "rejected_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "risk_score": { "type": "integer", "nullable": true },
          "risk_level": { "type": "string", "nullable": true },
          "risk_reasons": { "type": "array", "items": { "type": "string" }, "nullable": true },
          "analyzed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "PaginationEnvelope": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Expense" } }
        }
      },
      "BudgetInfo": {
        "type": "object",
        "properties": {
          "budget": { "type": "number", "nullable": true },
          "spent": { "type": "number" },
          "remaining": { "type": "number", "nullable": true },
          "over_budget": { "type": "boolean" }
        }
      },
      "RiskBreakdown": {
        "type": "object",
        "properties": {
          "risk_score": { "type": "integer" },
          "risk_level": { "type": "string" },
          "risk_reasons": { "type": "array", "items": { "type": "string" } },
          "analyzed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Department": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "monthly_budget": { "type": "number", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "first_name", "last_name"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "emp@test.com" },
                  "password": { "type": "string", "minLength": 1, "example": "password123" },
                  "first_name": { "type": "string", "example": "John" },
                  "last_name": { "type": "string", "example": "Doe" },
                  "role": { "type": "string", "enum": ["employee", "manager", "finance"], "default": "employee" },
                  "department_id": { "type": "integer", "description": "Required for employee and manager roles", "example": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered",
            "content": {
              "application/json": {
                "example": { "message": "registered successfully", "user": { "id": 1, "email": "emp@test.com", "role": "employee", "department_id": 1 } }
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "example": { "message": "email, password, first_name and last_name are required" } } } },
          "409": { "description": "Email already exists", "content": { "application/json": { "example": { "message": "Email already exists" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login and get JWT access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "emp.eng@test.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "access_token": "eyJhbGciOiJIUzI1NiIs...",
                  "user": { "id": 2, "email": "emp.eng@test.com", "role": "employee", "department_id": 1 }
                }
              }
            }
          },
           "400": { "description": "Missing email or password", "content": { "application/json": { "example": { "message": "email and password are required" } } } },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "example": { "message": "Invalid credentials" } } } }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout and revoke current JWT token",
        "description": "Adds the token's jti to the blocklist. Subsequent requests with the same token will be rejected.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out", "content": { "application/json": { "example": { "message": "logged out successfully" } } } },
          "401": { "description": "Invalid or expired token" }
        }
      }
    },
    "/expenses/": {
      "get": {
        "tags": ["Expenses"],
        "summary": "List expenses with filtering, sorting, and pagination",
        "description": "Employee sees own. Manager sees department. Finance sees all (with optional department_id filter).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "start_date", "in": "query", "schema": { "type": "string" }, "description": "Filter by created_at >= (ISO 8601)", "example": "2026-01-01" },
          { "name": "end_date", "in": "query", "schema": { "type": "string" }, "description": "Filter by created_at <=", "example": "2026-12-31" },
          { "name": "category", "in": "query", "schema": { "type": "string", "enum": ["travel", "meals", "equipment", "software", "other"] } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected"] } },
          { "name": "min_amount", "in": "query", "schema": { "type": "number" } },
          { "name": "max_amount", "in": "query", "schema": { "type": "number" } },
          { "name": "department_id", "in": "query", "schema": { "type": "integer" }, "description": "Finance role only" },
          { "name": "sort_by", "in": "query", "schema": { "type": "string", "default": "created_at", "enum": ["title", "amount", "status", "category", "created_at", "submitted_at", "approved_at"] } },
          { "name": "sort_order", "in": "query", "schema": { "type": "string", "default": "desc", "enum": ["asc", "desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of expenses",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginationEnvelope" } } }
          },
          "401": { "description": "Missing or invalid token" }
        }
      },
      "post": {
        "tags": ["Expenses"],
        "summary": "Create a new expense (Employee only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "amount", "category"],
                "properties": {
                  "title": { "type": "string", "example": "Laptop stand" },
                  "amount": { "type": "number", "example": 49.99 },
                  "currency": { "type": "string", "default": "USD", "example": "USD" },
                  "category": { "type": "string", "enum": ["travel", "meals", "equipment", "software", "other"], "example": "equipment" },
                  "status": { "type": "string", "enum": ["draft", "submitted"], "default": "draft" },
                  "receipt_url": { "type": "string", "example": "https://receipts.example.com/123.pdf" },
                  "notes": { "type": "string", "example": "Ergonomic adjustment" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Expense created" },
          "400": { "description": "Missing required fields" },
          "403": { "description": "Only employees can create expenses" },
          "422": { "description": "Invalid category or currency" }
        }
      }
    },
    "/expenses/{id}": {
      "get": {
        "tags": ["Expenses"],
        "summary": "Get expense by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Expense details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Expense" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Expense not found" }
        }
      },
      "put": {
        "tags": ["Expenses"],
        "summary": "Update a draft expense (Employee only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "amount": { "type": "number" },
                  "currency": { "type": "string" },
                  "category": { "type": "string" },
                  "receipt_url": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Expense updated" },
          "403": { "description": "Only employees can update" },
          "422": { "description": "Not a draft or validation error" }
        }
      },
      "delete": {
        "tags": ["Expenses"],
        "summary": "Delete a draft expense (Employee only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Deleted, no content" },
          "403": { "description": "Only employees can delete" },
          "422": { "description": "Only draft expenses can be deleted" }
        }
      }
    },
    "/expenses/{id}/submit": {
      "post": {
        "tags": ["Workflow"],
        "summary": "Submit a draft expense for approval (Employee only)",
        "description": "Transitions status from draft to submitted. Auto-triggers risk analysis.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Expense submitted (includes risk analysis results)" },
          "403": { "description": "Only employees can submit" },
          "422": { "description": "Only draft expenses can be submitted" }
        }
      }
    },
    "/expenses/{id}/approve": {
      "post": {
        "tags": ["Workflow"],
        "summary": "Approve a submitted expense (Manager only)",
        "description": "Transitions status from submitted to approved. Updates department budget. Returns warning if over budget.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Expense approved (may include warning field if over budget)" },
          "403": { "description": "Only managers can approve" },
          "422": { "description": "Invalid transition, self-approval, or not your department" }
        }
      }
    },
    "/expenses/{id}/reject": {
      "post": {
        "tags": ["Workflow"],
        "summary": "Reject a submitted expense (Manager only)",
        "description": "Transitions from submitted to rejected. Requires a rejection_reason.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rejection_reason"],
                "properties": {
                  "rejection_reason": { "type": "string", "example": "Receipt is missing" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Expense rejected" },
          "400": { "description": "rejection_reason is required" },
          "403": { "description": "Only managers can reject" },
          "422": { "description": "Invalid transition, self-rejection, or not your department" }
        }
      }
    },
    "/expenses/{id}/reopen": {
      "post": {
        "tags": ["Workflow"],
        "summary": "Reopen a rejected expense back to draft (Employee only)",
        "description": "Transitions from rejected to draft. Clears rejection_reason.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Expense reopened as draft" },
          "403": { "description": "Only employees can reopen" },
          "422": { "description": "Only rejected expenses can be reopened" }
        }
      }
    },
    "/expenses/flagged": {
      "get": {
        "tags": ["Risk Analysis"],
        "summary": "List flagged expenses by risk threshold (Manager/Finance only)",
        "description": "Managers see only their own department's flagged expenses. Finance sees all.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "min_score", "in": "query", "schema": { "type": "integer", "default": 50 }, "description": "Minimum risk score threshold" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of flagged expenses",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginationEnvelope" } } }
          },
          "403": { "description": "Manager or Finance only" }
        }
      }
    },
    "/expenses/{id}/analyze": {
      "post": {
        "tags": ["Risk Analysis"],
        "summary": "Re-run risk analysis on an expense (Manager/Finance only)",
        "description": "Runs all 5 fraud detection rules and updates risk_score, risk_level, risk_reasons, and analyzed_at.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Risk analysis results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RiskBreakdown" },
                "example": { "risk_score": 55, "risk_level": "high", "risk_reasons": ["3 small equipment expenses today totalling $2425.00", "$2000 is 26.7x their usual (avg $75)", "Round number ($2000)"], "analyzed_at": "2026-07-29T18:07:43.698235" }
              }
            }
          },
          "403": { "description": "Manager or Finance only" },
          "404": { "description": "Expense not found" }
        }
      }
    },
    "/expenses/{id}/risk": {
      "get": {
        "tags": ["Risk Analysis"],
        "summary": "Get risk breakdown for an expense (Manager/Finance only)",
        "description": "Returns the current risk analysis results without re-running the analysis.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Risk breakdown",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RiskBreakdown" } } }
          },
          "403": { "description": "Manager or Finance only" },
          "404": { "description": "Expense not found" }
        }
      }
    },
    "/budgets/department": {
      "get": {
        "tags": ["Budgets"],
        "summary": "Get monthly budget info (Manager/Finance only)",
        "description": "Finance requires department_id. Manager auto-scoped to their own department.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "department_id", "in": "query", "schema": { "type": "integer" }, "description": "Required for Finance, ignored for Manager" },
          { "name": "month", "in": "query", "schema": { "type": "string" }, "description": "YYYY-MM format (defaults to current month)", "example": "2026-07" }
        ],
        "responses": {
          "200": {
            "description": "Budget information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BudgetInfo" },
                "example": { "budget": 50000.0, "spent": 1250.0, "remaining": 48750.0, "over_budget": false }
              }
            }
          },
          "403": { "description": "Insufficient permissions" },
          "404": { "description": "Department not found" }
        }
      }
    },
    "/departments/": {
      "get": {
        "tags": ["Departments"],
        "summary": "List all departments",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of departments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Department" }
                },
                "example": [
                  { "id": 1, "name": "Engineering", "monthly_budget": 50000.0, "created_at": "2026-07-29T...", "updated_at": "2026-07-29T..." },
                  { "id": 2, "name": "Marketing", "monthly_budget": 30000.0, "created_at": "2026-07-29T...", "updated_at": "2026-07-29T..." }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Departments"],
        "summary": "Create a department (Finance only)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "Engineering" },
                  "monthly_budget": { "type": "number", "example": 50000.0 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Department created" },
          "403": { "description": "Only finance can create departments" },
          "409": { "description": "Department already exists" }
        }
      }
    }
  }
}
